{
  "name": "foodio",
  "version": "1.7.0",
  "main": "expo-router/entry",
  "type": "module",
  "scripts": {
    "start": "expo start",
    "api": "json-server --watch mocks/db.json --routes mocks/routes.json --middlewares mocks/middlewares.cjs --port ${MOCK_PORT:-3000} --host 0.0.0.0 --delay ${MOCK_DELAY_MS:-400}",
