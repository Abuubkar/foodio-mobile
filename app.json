{
  "expo": {
    "name": "foodio",
    "slug": "foodio",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "foodio",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hedonarc.foodio",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.hedonarc.foodio"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-image",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Foodio uses your location to show which restaurants deliver to your address, and to place your own restaurant on the map."
        }
      ],
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png"
        }
      ],
      "expo-splash-screen",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Foodio needs your photo library so you can put a picture on your restaurant and its dishes.",
          "cameraPermission": "Foodio needs your camera so you can photograph a dish without leaving the app."
        }
      ],
      "expo-maps",
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4fd4b07c-510a-4321-be93-f2d430e7fe50"
      }
    },
    "owner": "abuubkar"
  }
}
